<?xml version="1.0"?>
<ruleset name="External Image Importer">
	<description>Coding standards for the External Image Importer plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!--
		The plugin is written in PSR-12-ish style with 4-space indentation
		rather than WordPress-Core formatting, so only the correctness and
		security sniffs are enforced.
	-->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.WP.AlternativeFunctions"/>
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DeprecatedParameters"/>
	<rule ref="WordPress.WP.EnqueuedResources"/>
	<rule ref="WordPress.WP.GlobalVariablesOverride"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="external-image-importer"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.DB"/>
	<rule ref="WordPress.PHP.NoSilencedErrors"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="eximgimp"/>
				<element value="external_image_importer"/>
				<element value="ExternalImageImporter"/>
			</property>
		</properties>
	</rule>

	<!-- Tests use stubbed globals and framework naming. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>

	<!-- Test fixtures embed real image bytes as base64. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.1-"/>
</ruleset>
